// 広い道優先 + 所要時間補正（両プロファイル共通）。car.json の後にマージされる。
// 調整値: docs/CONTEXT.md「細い道ペナルティ」= 5 → priority 0.2、「速度係数」4 種
{
  // 所要時間補正。car.json の速度（独の既定値 primary 65 / secondary 60 km/h、maxspeed があれば ×0.9）は
  // 日本の実走より 2〜3 倍速い（信号・渋滞を含まない）。市街地判定 urban_density ごとに掛ける。
  // 高速は密度を問わず一律。*_link は親クラスに畳まれるので MOTORWAY にランプも含む
  "speed": [
    { "if": "road_class == MOTORWAY", "multiply_by": "0.85" },
    { "else_if": "urban_density == CITY", "multiply_by": "0.4" },
    { "else_if": "urban_density == RESIDENTIAL", "multiply_by": "0.55" },
    { "else": "", "multiply_by": "0.75" }
  ],
  "priority": [
    {
      "if": "road_class == UNCLASSIFIED || road_class == RESIDENTIAL || road_class == SERVICE || road_class == LIVING_STREET || road_class == ROAD || road_class == BUSWAY || road_class == OTHER",
      "multiply_by": "0.2"
    },
    { "if": "road_class == TRACK", "multiply_by": "0" },
    { "if": "road_environment == FERRY", "multiply_by": "0" },
    {
      "if": "surface == UNPAVED || surface == COMPACTED || surface == FINE_GRAVEL || surface == GRAVEL || surface == GROUND || surface == DIRT || surface == GRASS || surface == SAND",
      "multiply_by": "0"
    }
  ]
}
