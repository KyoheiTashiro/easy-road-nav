// 広い道優先（両プロファイル共通）。car.json の後にマージされる。
// 調整値: docs/CONTEXT.md「細い道ペナルティ」= 5 → priority 0.2
{
  "priority": [
    {
      "if": "road_class == UNCLASSIFIED || road_class == RESIDENTIAL || road_class == SERVICE || road_class == LIVING_STREET || road_class == ROAD || road_class == BUSWAY || road_class == OTHER",
      "multiply_by": "0.2"
    },
    { "if": "road_class == TRACK", "multiply_by": "0" },
    { "if": "road_environment == FERRY", "multiply_by": "0" },
    {
      "if": "surface == UNPAVED || surface == COMPACTED || surface == FINE_GRAVEL || surface == GRAVEL || surface == GROUND || surface == DIRT || surface == GRASS || surface == SAND",
      "multiply_by": "0"
    }
  ]
}
