{
  "name": "easy-road-nav",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "deploy": "npm run build && rsync -az --delete dist/ ${VPS_HOST:?set VPS_HOST}:/srv/easy-road-nav/web/",
    "deploy:graph": "sh scripts/deploy-graph.sh"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "maplibre-gl": "6.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.4",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/postcss-plugin": "0.19.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
